# ==============================================================================
# GITHUB REPOSITORY BINARY MEDIA STORAGE (PERMANENT PRODUCTION STORAGE)
# ==============================================================================
# Because Vercel production serverless filesystems are ephemeral (read-only / wiped
# between instances), uploaded images are permanently committed as actual binary
# files directly into your GitHub repository via the GitHub REST API.
#
# Configure these variables in:
# 1. Local environment (.env)
# 2. Vercel Dashboard: Project Settings > Environment Variables
#
# GITHUB_TOKEN: GitHub Personal Access Token (PAT).
#   - Fine-Grained PAT: Repository Permissions -> "Contents: Read and write"
#   - Classic PAT: Check the "repo" scope.
#   - Kept strictly server-side. Never exposed to the browser client.
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# GITHUB_OWNER: GitHub username or organization that owns the repository (e.g. "soairsocial").
GITHUB_OWNER="your_github_username_or_org"

# GITHUB_REPO: Repository name where the ecommerce app is hosted (e.g. "lariel-essentials").
GITHUB_REPO="your_repository_name"

# GITHUB_BRANCH: The deployment branch to commit images and data to (default: "main").
GITHUB_BRANCH="main"

# GITHUB_COMMITTER_NAME: (Optional) Author name for automated git commits.
GITHUB_COMMITTER_NAME="Lariel Essentials Admin"

# GITHUB_COMMITTER_EMAIL: (Optional) Author email for automated git commits.
GITHUB_COMMITTER_EMAIL="admin@larielextravaganza.com"

# STORAGE_PROVIDER: (Optional) Force active primary storage provider ("github", "cloudflare-r2", "local").
STORAGE_PROVIDER="github"

# ==============================================================================
# CLOUDFLARE R2 PERSISTENT MEDIA STORAGE (SECONDARY / OBJECT STORAGE)
# ==============================================================================
# CLOUDFLARE_ACCOUNT_ID: Your Cloudflare 32-character hexadecimal Account ID.
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_hex"

# R2_ACCESS_KEY_ID: S3-compatible Access Key ID for R2 API token with Object Read & Write permissions.
R2_ACCESS_KEY_ID="your_r2_access_key_id"

# R2_SECRET_ACCESS_KEY: S3-compatible Secret Access Key for R2 API token.
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2_BUCKET_NAME: Dedicated R2 bucket name for Lariel Essentials production media.
R2_BUCKET_NAME="lariel-essentials-media"

# R2_ENDPOINT: (Optional) Account-specific S3-compatible endpoint.
# Defaults to: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your_cloudflare_account_id_hex.r2.cloudflarestorage.com"

# R2_PUBLIC_BASE_URL: Public media delivery hostname connected to your R2 bucket.
R2_PUBLIC_BASE_URL="https://media.larielextravaganza.com"

# MAX_FILE_SIZE_BYTES: (Optional) Maximum permitted image upload size in bytes (default: 15728640 = 15MB).
MAX_FILE_SIZE_BYTES="15728640"

# ==============================================================================
# LEGACY / BACKUP STORAGE
# ==============================================================================
# BLOB_READ_WRITE_TOKEN: Permanent Vercel Blob object storage token on Vercel deployments.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
